# Тестовые значения для запуска тестов
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=test-redis-password

QUEUE_HIGH=queue:high
QUEUE_MED=queue:med
QUEUE_LOW=queue:low
DLQ=queue:dead

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mvp_agent
DB_USER=postgres
DB_PASSWORD=test-db-password

BOT_TOKEN=123456789:TEST_TOKEN_DO_NOT_USE_IN_PRODUCTION
BOT_ADMIN_ID=123456789

BROWSER_PROFILE_DIR=./browser-profile
BROWSER_HEADLESS=true
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

EVIDENCE_DIR=./evidence

LOG_LEVEL=INFO
METRICS_PORT=9090

MAX_HOURS_PER_CLIENT_PER_MONTH=60

# LLM_API_KEY намеренно не задан: тесты не должны ходить в реальный LLM API.
# Тесты планировщика подменяют client.complete самостоятельно.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000