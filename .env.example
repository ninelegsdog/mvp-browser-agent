# ============================================================================
# Переменные окружения для MVP Browser Agent
# ============================================================================
# Скопируйте в .env и заполните реальными значениями перед запуском.
# Все переменные обязательны, если не указано иное.

# --- Redis (очередь задач) ---
# URL подключения к Redis. Если установлен REDIS_PASSWORD, используйте формат:
# redis://:password@localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change-me-strong-redis-password

# --- Очереди задач ---
QUEUE_HIGH=queue:high
QUEUE_MED=queue:med
QUEUE_LOW=queue:low
DLQ=queue:dead

# --- PostgreSQL (Outbox) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mvp_agent
DB_USER=postgres
DB_PASSWORD=change-me-strong-db-password

# --- Telegram Bot ---
# Получите у @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Ваш Telegram ID (узнайте у @userinfobot)
BOT_ADMIN_ID=123456789

# --- Браузер (Playwright) ---
BROWSER_PROFILE_DIR=./browser-profile
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800

# --- Доказательства (скриншоты, видео, trace) ---
EVIDENCE_DIR=./evidence

# --- Логирование и мониторинг ---
LOG_LEVEL=INFO
METRICS_PORT=9090

# --- НПД / лимиты ---
MAX_HOURS_PER_CLIENT_PER_MONTH=60