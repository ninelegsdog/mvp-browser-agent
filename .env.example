# =============================================================================
# Переменные окружения MVP Browser Agent
# =============================================================================
# Это шаблон. Скопируйте его и заполните значения:
#
#   cp .env.example .env
#   nano .env
#
# Проверить, всё ли заполнено, можно до первого запуска:
#
#   python scripts/preflight.py            # только конфигурация
#   python scripts/preflight.py --network  # плюс Redis, PostgreSQL и сайты
#
# Файл .env не попадает в git (.gitignore). Не отправляйте его в чат и не
# пересылайте по почте: значения передаются только на вашем сервере.
# =============================================================================

# --- Redis: очередь задач ----------------------------------------------------
# Пароль обязателен: приложение не стартует без него.
# Сгенерировать: openssl rand -base64 24
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=change-me-strong-redis-password

# Имена очередей менять не нужно — это внутренние ключи Redis.
QUEUE_HIGH=queue:high
QUEUE_MED=queue:med
QUEUE_LOW=queue:low
DLQ=queue:dead

# --- PostgreSQL: журнал событий (outbox) -------------------------------------
# Пароль обязателен. Сгенерировать: openssl rand -base64 24
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mvp_agent
DB_USER=postgres
DB_PASSWORD=change-me-strong-db-password

# --- Telegram: пульт управления ----------------------------------------------
# BOT_TOKEN — у @BotFather: /newbot или /token
# BOT_ADMIN_ID — ваш числовой ID, узнать у @userinfobot (не @username!)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_ADMIN_ID=123456789

# --- LLM: модель, которая выбирает действия в браузере -----------------------
# Любой OpenAI-совместимый API. Без ключа агент запустится, но решения
# принимать не будет — в лог уйдёт предупреждение.
#
#   OpenAI:    https://api.openai.com/v1        gpt-4o
#   OpenRouter: https://openrouter.ai/api/v1    anthropic/claude-3.5-sonnet
#   локально:  http://localhost:11434/v1        llama3.1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# --- Браузер: постоянный профиль и вход по QR --------------------------------
# Профиль хранит куки и сессию после ручного входа с телефона.
# Каталог создаётся сам с правами 0700 и никогда не попадает в git.
BROWSER_PROFILE_DIR=./browser-profile
# false — окно видно (нужно для первого входа по QR), true — без окна.
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=800
# Если маркетплейс не открывается с VPS напрямую — укажите прокси.
# Формат: http://user:pass@host:port или socks5://host:port
BROWSER_PROXY=
# Сколько секунд ждать ручной вход по QR, прежде чем сказать «не вошли».
QR_LOGIN_TIMEOUT_SECONDS=600
# Шифровать профиль после остановки (Fernet, ключ ~/.secrets/browser-profile.key).
# Нужно для бэкапа/переноса профиля; для обычной работы достаточно прав 0700.
BROWSER_PROFILE_ENCRYPTION=false

# --- Доказательства: скриншоты, видео, trace ---------------------------------
EVIDENCE_DIR=./evidence

# --- Логи и метрики ----------------------------------------------------------
LOG_LEVEL=INFO
METRICS_PORT=9090
# 0.0.0.0 — слушать внутри контейнера; снаружи порт публикуется явно.
METRICS_HOST=0.0.0.0

# --- Ограничения работы ------------------------------------------------------
# Лимит часов на одного заказчика в месяц (самозанятость, НПД).
MAX_HOURS_PER_CLIENT_PER_MONTH=60
